#!/bin/sh
set -eu

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Merge/Revert 커밋은 GitHub·git이 자체 형식으로 생성 — 컨벤션 검사 대상 아님
case "$first_line" in
Merge\ * | Revert\ *)
	exit 0
	;;
esac

# COMMIT_RE는 harness-map.md의 {{커밋 메시지 형식}}과 짝이다 — 훅은 슬롯을 읽지 못하므로 여기 직접 적는다.
# 배달본은 프로젝트 값을 갖지 않아 비워 둔다. init-harness가 저장소 이력에서 실측한 형식을 정규식으로 채운다. 빈 값이면 검사하지 않는다.
COMMIT_RE=""

[ -n "$COMMIT_RE" ] || exit 0

if ! printf '%s' "$first_line" | grep -Eq "$COMMIT_RE"; then
	echo "FAIL: 커밋 메시지 첫 줄이 이 저장소의 커밋 형식과 맞지 않습니다 (harness-map.md {{커밋 메시지 형식}})." >&2
	echo "  정규식: ${COMMIT_RE}" >&2
	echo "  받은 첫 줄: ${first_line}" >&2
	exit 1
fi
